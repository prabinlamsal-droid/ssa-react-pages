{
  "version": 1,
  "endpoints": {
    "kycCountry": {
      "method": "GET"
    },
    "chartHistory": {
      "method": "GET",
      "queryFields": {
        "symbol":{"type":"string","pattern":"^[A-Z0-9_-]{1,20}$"},
        "resolution":{"type":"string","values":["1","1D","1W","1M"]},
        "from":{"type":"integer","min":1},
        "to":{"type":"integer","min":1},
        "countback":{"type":"integer","min":1,"max":1000}
      },
      "requiredQuery":["symbol","resolution","from","to","countback"]
    }
  },
  "shelf": {
    "demo.note": {
      "type": "string"
    },
    "themeMode": {
      "type": "string",
      "values": [
        "ThemeMode.system",
        "ThemeMode.light",
        "ThemeMode.dark"
      ]
    },
    "balanceVisibility": {
      "type": "boolean"
    }
  }
}
